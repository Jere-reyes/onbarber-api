{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onbarber-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onbarber-db",
      "database_id": "c95f138e-cc0b-4872-9b97-a21e270f75b1",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://onbarber.com.py,http://localhost:4321"
  }
}
